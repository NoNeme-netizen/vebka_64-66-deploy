# Переменные окружения деплоя «Манчкин-пикер»
# Скопируйте в .env и заполните значения (.env в репозиторий не попадает).

# --- приложение ---
# секрет подписи cookie-сессии
SESSION_SECRET=

# --- Supabase (облачная база данных) ---
# Project URL (Settings -> Data API), БЕЗ хвоста /rest/v1
SUPABASE_URL=
# service_role secret (Settings -> API Keys -> Secret keys; ТОЛЬКО для сервера)
SUPABASE_SERVICE_ROLE_KEY=
